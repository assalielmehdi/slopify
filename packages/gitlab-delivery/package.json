{
  "name": "@loop/gitlab-delivery",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "source": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm --filter @loop/execution-runtime build && tsc --project tsconfig.json",
    "typecheck": "pnpm --filter @loop/execution-runtime build && tsc --project tsconfig.json --noEmit",
    "lint": "eslint src tests --max-warnings 0",
    "test": "vitest run --root ../.. packages/gitlab-delivery/tests"
  },
  "dependencies": {
    "@loop/contracts": "workspace:*",
    "@loop/execution-runtime": "workspace:*"
  }
}
