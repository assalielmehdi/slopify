{
  "name": "@loop/workflow-model",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "source": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm --filter @loop/contracts build && tsc --project tsconfig.json",
    "typecheck": "pnpm --filter @loop/contracts build && tsc --project tsconfig.json --noEmit",
    "lint": "eslint src tests --max-warnings 0",
    "test": "vitest run --root ../.. packages/workflow-model/tests"
  },
  "dependencies": {
    "@loop/contracts": "workspace:*",
    "zod": "4.4.3"
  }
}
