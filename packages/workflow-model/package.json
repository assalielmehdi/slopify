{
  "name": "@slopify/workflow-model",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "source": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "bun -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\"",
    "build": "bun run clean && bun ../../node_modules/typescript-go/bin/tsc --project tsconfig.json",
    "dev": "bun ../../node_modules/typescript-go/bin/tsc --project tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "bun ../../node_modules/typescript-go/bin/tsc --project tsconfig.json --noEmit",
    "lint": "bun --bun eslint . --max-warnings 0",
    "test": "bun --bun vitest run --root ../.. packages/workflow-model/tests"
  },
  "dependencies": {
    "@slopify/contracts": "workspace:*",
    "zod": "4.4.3"
  }
}
