{
  "name": "@loop/execution-runtime",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "source": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun run --filter @loop/agent-runtimes build && bun ../../node_modules/typescript-go/bin/tsc --project tsconfig.json",
    "typecheck": "bun run --filter @loop/agent-runtimes build && bun ../../node_modules/typescript-go/bin/tsc --project tsconfig.json --noEmit",
    "lint": "bun --bun eslint src tests --max-warnings 0",
    "test": "bun --bun vitest run --root ../.. packages/execution-runtime/tests"
  },
  "dependencies": {
    "@loop/agent-runtimes": "workspace:*",
    "@loop/contracts": "workspace:*",
    "@loop/workflow-model": "workspace:*",
    "execa": "10.0.1",
    "zod": "4.4.3"
  }
}
