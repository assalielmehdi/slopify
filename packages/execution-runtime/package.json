{
  "name": "@slopify/execution-runtime",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "source": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm --filter @slopify/agent-runtimes build && tsc --project tsconfig.json",
    "typecheck": "pnpm --filter @slopify/agent-runtimes build && tsc --project tsconfig.json --noEmit",
    "lint": "eslint src tests --max-warnings 0",
    "test": "vitest run --root ../.. packages/execution-runtime/tests"
  },
  "dependencies": {
    "@slopify/agent-runtimes": "workspace:*",
    "@slopify/contracts": "workspace:*",
    "@slopify/workflow-model": "workspace:*",
    "better-sqlite3": "13.0.3",
    "execa": "10.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "9.6.0"
  }
}
