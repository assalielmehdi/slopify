# Browser binding. Keep APP_HOST on loopback for the unauthenticated V1 app.
APP_HOST=127.0.0.1
APP_PORT=3000

# Existing host directory exposed to the API as /workspace.
WORKSPACE_HOST_PATH=./workspace

# The database path must stay below /var/lib/workbench in Compose mode.
DATABASE_PATH=/var/lib/workbench/workbench.sqlite
# Keep this at or below 10000 so Compose's 20-second stop grace can flush data.
API_SHUTDOWN_GRACE_MS=10000

# ClickUp workspace, list, and in-review status IDs are configured per project
# profile in the UI; only the runtime token comes from the environment.
CLICKUP_API_TOKEN=

# GitLab host and token used by the API and bundled glab client.
GITLAB_HOST=https://gitlab.com
GITLAB_TOKEN=

# Pi provider, model, and thinking level have no global Compose defaults. They
# are immutable workflow-revision fields. MODEL_PROVIDER_API_KEY is the V1
# selected-provider credential and readiness signal.
MODEL_PROVIDER_API_KEY=

# Optional credential-file authentication is not mounted by default. Keep the
# file outside this repository and add the documented read-only local Compose
# override only when a credential-file adapter is explicitly configured.
# PI_CREDENTIALS_FILE_HOST_PATH=/absolute/path/to/pi-auth.json
