# Slopify orchestrator state. Defaults to ~/.slopify/orchestrator when omitted.
SLOPIFY_HOME=/Users/you/.slopify/orchestrator

# Native API server and same-origin web proxy.
API_HOST=127.0.0.1
API_PORT=3001
API_INTERNAL_URL=http://127.0.0.1:3001

# Optional state path overrides. Defaults are below SLOPIFY_HOME.
# DATABASE_PATH=/Users/you/.slopify/orchestrator/slopify.db
# TRACES_ROOT=/Users/you/.slopify/orchestrator/traces
# WORKTREES_ROOT=/Users/you/.slopify/orchestrator/worktrees
# API_SHUTDOWN_GRACE_MS=10000
