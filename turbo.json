{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    ".prettierignore",
    "bunfig.toml",
    "eslint.config.mjs",
    "prettier.config.mjs",
    "tsconfig.base.json",
    "vitest.config.ts"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "!.next/dev/**"]
    },
    "clean": {
      "cache": false
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "@slopify/agent-runtimes#dev": {
      "dependsOn": ["build", "^build"],
      "cache": false,
      "persistent": true
    },
    "@slopify/execution-runtime#dev": {
      "dependsOn": ["build", "^build"],
      "cache": false,
      "persistent": true
    },
    "@slopify/shared#dev": {
      "dependsOn": ["build", "^build"],
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": []
    },
    "start": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@slopify/web#test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/.bun-version",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/turbo.json",
        "$TURBO_ROOT$/apps/api/package.json",
        "$TURBO_ROOT$/apps/api/src/server.ts",
        "$TURBO_ROOT$/packages/*/package.json",
        "$TURBO_ROOT$/src/api/package.json",
        "$TURBO_ROOT$/src/shared/package.json"
      ],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "//#format:root": {
      "cache": false
    },
    "//#lint:root": {
      "outputs": []
    },
    "//#typecheck:root": {
      "outputs": []
    }
  }
}
