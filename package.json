{
  "name": "slopify",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": "24.18.0",
    "pnpm": "11.22.0"
  },
  "scripts": {
    "build": "pnpm --recursive --if-present run build",
    "typecheck": "tsc --project tsconfig.json && pnpm --recursive --if-present run typecheck",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:containers": "vitest run --config vitest.container.config.ts",
    "test:e2e": "playwright test",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.8.1",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.11"
  }
}
