{
  "name": "slopify",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "bun": "1.4.0"
  },
  "scripts": {
    "build": "bun run --workspaces --if-present build",
    "typecheck": "bun node_modules/typescript-go/bin/tsc --project tsconfig.json && bun run --workspaces --if-present typecheck",
    "lint": "bun --bun eslint . --max-warnings 0",
    "test": "bun --bun vitest run",
    "test:containers": "bun --bun vitest run --config vitest.container.config.ts",
    "test:e2e": "bun --bun playwright test",
    "format:check": "bun --bun prettier --check ."
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.3",
    "@types/bun": "1.3.14",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.8.1",
    "prettier": "3.9.6",
    "typescript": "5.9.3",
    "typescript-go": "npm:typescript@7.0.2",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.11"
  }
}
