{
  "name": "@slopify/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "types": "./dist/app.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "clean": "bun -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\"",
    "build": "bun run clean && bun ../../node_modules/typescript-go/bin/tsc --project tsconfig.json",
    "dev": "bun --watch --conditions=source src/server.ts",
    "typecheck": "bun ../../node_modules/typescript-go/bin/tsc --project tsconfig.json --noEmit",
    "lint": "bun --bun eslint . --max-warnings 0",
    "test": "bun --bun vitest run --root ../.. src/api/tests",
    "start": "bun dist/server.js"
  },
  "dependencies": {
    "@slopify/agent-runtimes": "workspace:*",
    "@slopify/shared": "workspace:*",
    "execa": "10.0.1",
    "hono": "4.13.3",
    "zod": "4.4.3"
  }
}
