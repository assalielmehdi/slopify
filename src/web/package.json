{
  "name": "@slopify/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun run clean && bun --bun next typegen && bun ../../node_modules/typescript-go/bin/tsc --project tsconfig.json --noEmit && bun --bun next build",
    "clean": "bun -e \"import { rmSync } from 'node:fs'; rmSync('.next', { force: true, recursive: true })\"",
    "dev": "bun --bun next dev --port 7310",
    "start": "bun --bun next start --port 7310",
    "lint": "bun --bun eslint . --max-warnings 0",
    "test": "bun --bun vitest run --config vitest.config.ts",
    "typecheck": "bun --bun next typegen && bun ../../node_modules/typescript-go/bin/tsc --project tsconfig.json --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "1.7.0",
    "@dagrejs/dagre": "3.1.1",
    "@slopify/shared": "workspace:*",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "1.31.0",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "4.18.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "jsdom": "30.0.1",
    "tailwindcss": "4.3.3"
  }
}
